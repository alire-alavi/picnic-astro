---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import "../../styles/css/global.css";
import "../../styles/css/dependencies/swiper.min.css";
import "../../styles/css/fonts.css";
import "../../styles/css/app.css";
import "../../styles/css/base.css";
import "../../styles/css/reset.css";
---

<Layout>
  <Navbar />

  <main class="flex-grow bg-background mt-4 pt-[106px]">
    <div class="container grid grid-cols-12 gap-4 pb-28 pt-10 lg:pb-10">
      <!-- Sidebar -->
      <div class="col-span-12 lg:col-span-3">
        <!-- Profile card -->
        <div class="mb-4 rounded-lg bg-muted p-4 shadow">
          <!-- Desktop -->
          <div class="hidden items-center justify-between gap-2 lg:flex">
            <div class="flex items-center gap-4">
              <div
                class="flex h-10 w-10 items-center justify-center rounded-full bg-primary-btn text-center text-lg font-semibold text-white"
                data-user-avatar
              >
                ک
              </div>
              <p class="line-clamp-1" data-user-name>کاربر</p>
            </div>
            <a
              href="/dashboard/profile-edit"
              class="rounded-full text-sm text-primary duration-300 hover:text-primary/80"
            >
              <div class="i-lucide-pen-line size-6"></div>
            </a>
          </div>
          <!-- Mobile -->
          <div class="flex items-center justify-center lg:hidden">
            <div class="flex flex-col items-center justify-center gap-y-4">
              <div class="relative">
                <div
                  class="flex h-16 w-16 items-center justify-center rounded-full bg-primary-btn text-center text-lg font-semibold text-white"
                  data-user-avatar-mobile
                >
                  ک
                </div>
                <a
                  href="/dashboard/profile-edit"
                  class="absolute -right-3 -top-2 rounded-full border bg-muted p-1.5 text-sm text-primary"
                >
                  <div class="i-lucide-pen-line size-5"></div>
                </a>
              </div>
              <div class="text-center">
                <p class="line-clamp-1" data-user-name-mobile>کاربر</p>
                <p class="text-text/95" data-user-phone></p>
              </div>
              <div>
                <button
                  type="button"
                  data-drawer-target="profile-drawer"
                  data-drawer-show="profile-drawer"
                  data-drawer-placement="bottom"
                  aria-controls="profile-drawer"
                  class="btn-primary flex items-center gap-1 px-4 py-2"
                >
                  <div class="i-lucide-align-justify size-5"></div>
                  منوی پنل کاربری
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Desktop nav links -->
        <div class="hidden rounded-lg shadow lg:block">
          <ul class="relative space-y-2 rounded-lg bg-muted p-2">
            <li>
              <a
                href="/dashboard"
                class="inline-flex w-full items-center justify-between rounded-lg p-4 text-text/80 duration-300 hover:text-primary"
              >
                <div class="flex items-center gap-4">
                  <div class="i-solar-home-smile-linear size-6"></div>
                  پیشخوان
                </div>
              </a>
            </li>
            <li>
              <a
                href="/dashboard/orders"
                class="inline-flex w-full items-center justify-between rounded-lg bg-primary/5 p-4 text-primary duration-300"
              >
                <div class="flex items-center gap-4">
                  <div class="i-mingcute-shopping-bag-3-line size-6"></div>
                  سفارش ها
                </div>
              </a>
            </li>
            <li>
              <a
                href="/dashboard/notifications"
                class="inline-flex w-full items-center justify-between rounded-lg p-4 text-text/80 duration-300 hover:text-primary"
              >
                <div class="flex items-center gap-4">
                  <div class="i-lucide-bell size-6"></div>
                  پیام ها
                </div>
              </a>
            </li>
            <li>
              <a
                href="/dashboard/favorites"
                class="inline-flex w-full items-center justify-between rounded-lg p-4 text-text/80 duration-300 hover:text-primary"
              >
                <div class="flex items-center gap-4">
                  <div class="i-lucide-heart size-6"></div>
                  علاقه‌‍مندی ها
                </div>
              </a>
            </li>
            <li>
              <a
                href="/dashboard/recent"
                class="inline-flex w-full items-center justify-between rounded-lg p-4 text-text/80 duration-300 hover:text-primary"
              >
                <div class="flex items-center gap-4">
                  <div class="i-lucide-mouse-pointer-click size-6"></div>
                  بازدید های اخیر
                </div>
              </a>
            </li>
            <li>
              <a
                href="/dashboard/addresses"
                class="inline-flex w-full items-center justify-between rounded-lg p-4 text-text/80 duration-300 hover:text-primary"
              >
                <div class="flex items-center gap-4">
                  <div
                    class="i-material-symbols-location-on-outline-rounded size-6"
                  >
                  </div>
                  آدرس ها
                </div>
              </a>
            </li>
            <li>
              <a
                href="/dashboard/profile-edit"
                class="inline-flex w-full items-center justify-between rounded-lg p-4 text-text/80 duration-300 hover:text-primary"
              >
                <div class="flex items-center gap-4">
                  <div class="i-lucide-user-cog size-6"></div>
                  اطلاعات حساب کاربری
                </div>
              </a>
            </li>
            <li>
              <button
                type="button"
                data-logout-btn
                class="inline-flex w-full items-center justify-between p-4 text-warning"
              >
                <div class="flex items-center gap-4">
                  <div class="i-mingcute-exit-line size-6"></div>
                  خروج
                </div>
              </button>
            </li>
          </ul>
        </div>
      </div>

      <!-- Content -->
      <div class="col-span-12 lg:col-span-9">
        <div class="rounded-lg bg-muted shadow">
          <div class="p-5">
            <h1 class="relative mb-16 w-fit font-medium lg:text-lg">
              سفارشات شما
              <span
                class="absolute right-0 top-10 h-[3px] w-full animate-fill-border rounded-full bg-primary"
              ></span>
            </h1>

            <!-- Pending payment orders -->
            <div class="mb-8" id="pending-payment-section">
              <div
                class="mb-8 flex flex-wrap items-center justify-between gap-4"
              >
                <h3 class="flex items-center gap-x-4 text-lg text-text/80">
                  <span class="h-2 w-2 rounded-full bg-primary"></span>
                  سفارشات در انتظار پرداخت
                </h3>
              </div>
              <!-- Populated via API -->
              <div class="space-y-4" data-pending-orders>
                <div class="flex justify-center py-6" data-empty>
                  <div
                    class="flex flex-col items-center justify-center gap-y-4 text-text/60"
                  >
                    <div
                      class="i-material-symbols-light-content-paste-off-rounded size-16"
                    >
                    </div>
                    <p>سفارشی در انتظار پرداخت وجود ندارد</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- All orders with filter tabs -->
            <div class="mb-8">
              <div
                class="mb-8 flex flex-wrap items-center justify-between gap-4"
              >
                <h3 class="flex items-center gap-x-4 text-lg text-text/80">
                  <span class="h-2 w-2 rounded-full bg-primary"></span>
                  سفارشات
                </h3>
              </div>

              <!-- Filter tabs -->
              <ul
                class="mb-8 flex flex-wrap items-center justify-center gap-2 md:justify-start"
                id="order-filter-tab"
                data-tabs-toggle="#order-filter-tab-content"
                data-tabs-active-classes="btn-primary"
                data-tabs-inactive-classes="btn-secondary"
                role="tablist"
              >
                <li role="presentation">
                  <button
                    id="filter-all-tab"
                    data-tabs-target="#filter-all"
                    type="button"
                    role="tab"
                    aria-controls="filter-all"
                    aria-selected="true"
                    class="flex items-center gap-2 rounded-lg px-6 py-2 text-sm"
                  >
                    همه
                    <span data-tab-count-all></span>
                  </button>
                </li>
                <li role="presentation">
                  <button
                    id="filter-current-tab"
                    data-tabs-target="#filter-current"
                    type="button"
                    role="tab"
                    aria-controls="filter-current"
                    aria-selected="false"
                    class="flex items-center gap-2 rounded-lg px-6 py-2 text-sm"
                  >
                    فعلی
                    <span data-tab-count-current></span>
                  </button>
                </li>
                <li role="presentation">
                  <button
                    id="filter-delivered-tab"
                    data-tabs-target="#filter-delivered"
                    type="button"
                    role="tab"
                    aria-controls="filter-delivered"
                    aria-selected="false"
                    class="flex items-center gap-2 rounded-lg px-6 py-2 text-sm"
                  >
                    تحویل شده
                    <span data-tab-count-delivered></span>
                  </button>
                </li>
                <li role="presentation">
                  <button
                    id="filter-canceled-tab"
                    data-tabs-target="#filter-canceled"
                    type="button"
                    role="tab"
                    aria-controls="filter-canceled"
                    aria-selected="false"
                    class="flex items-center gap-2 rounded-lg px-6 py-2 text-sm"
                  >
                    لغو شده
                    <span data-tab-count-canceled></span>
                  </button>
                </li>
              </ul>

              <div id="order-filter-tab-content">
                <!-- All tab -->
                <div
                  id="filter-all"
                  role="tabpanel"
                  aria-labelledby="filter-all-tab"
                >
                  <div class="space-y-4" data-orders-all>
                    <!-- Empty state -->
                    <div class="flex justify-center py-10" data-empty>
                      <div
                        class="flex flex-col items-center justify-center gap-y-4 text-text/60"
                      >
                        <div
                          class="i-material-symbols-light-content-paste-off-rounded size-20"
                        >
                        </div>
                        <p class="md:text-lg">لیست سفارش های شما خالی میباشد</p>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Current tab -->
                <div
                  class="hidden"
                  id="filter-current"
                  role="tabpanel"
                  aria-labelledby="filter-current-tab"
                >
                  <div class="space-y-4" data-orders-current>
                    <div class="flex justify-center py-10" data-empty>
                      <div
                        class="flex flex-col items-center justify-center gap-y-4 text-text/60"
                      >
                        <div
                          class="i-material-symbols-light-content-paste-off-rounded size-20"
                        >
                        </div>
                        <p class="md:text-lg">سفارش فعالی وجود ندارد</p>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Delivered tab -->
                <div
                  class="hidden"
                  id="filter-delivered"
                  role="tabpanel"
                  aria-labelledby="filter-delivered-tab"
                >
                  <div class="space-y-4" data-orders-delivered>
                    <div class="flex justify-center py-10" data-empty>
                      <div
                        class="flex flex-col items-center justify-center gap-y-4 text-text/60"
                      >
                        <div
                          class="i-material-symbols-light-content-paste-off-rounded size-20"
                        >
                        </div>
                        <p class="md:text-lg">سفارش تحویل شده‌ای وجود ندارد</p>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Canceled tab -->
                <div
                  class="hidden"
                  id="filter-canceled"
                  role="tabpanel"
                  aria-labelledby="filter-canceled-tab"
                >
                  <div class="space-y-4" data-orders-canceled>
                    <div class="flex justify-center py-10" data-empty>
                      <div
                        class="flex flex-col items-center justify-center gap-y-4 text-text/60"
                      >
                        <div
                          class="i-material-symbols-light-content-paste-off-rounded size-20"
                        >
                        </div>
                        <p class="md:text-lg">سفارش لغو شده‌ای وجود ندارد</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Mobile bottom nav -->
  <div
    data-onscrollclass="translate-y-full"
    class="fixed inset-x-0 bottom-0 z-20 bg-muted duration-300 lg:hidden"
  >
    <div class="container flex items-center text-sm">
      <div class="w-1/4 py-1">
        <a href="/" class="flex flex-col items-center justify-center">
          <i
            class="i-solar-home-smile-linear size-6 items-center justify-center"
          ></i>
          <p class="pt-2 text-xs xs:text-sm">خانه</p>
        </a>
      </div>
      <div class="w-1/4 py-1">
        <a href="/categories" class="flex flex-col items-center justify-center">
          <i class="i-iconamoon-category-light size-6"></i>
          <p class="pt-2 text-xs xs:text-sm">دسته ها</p>
        </a>
      </div>
      <div class="w-1/4 py-1">
        <a href="/cart" class="flex flex-col items-center justify-center">
          <i class="i-lucide-shopping-cart size-6"></i>
          <p class="pt-2 text-xs xs:text-sm">سبد خرید</p>
        </a>
      </div>
      <div
        class="w-1/4 border-b-2 border-primary py-1 font-medium text-primary"
      >
        <a
          href="/dashboard/orders"
          class="flex flex-col items-center justify-center"
        >
          <i class="i-lucide-user-round size-6"></i>
          <p class="pt-2 text-xs xs:text-sm">حساب من</p>
        </a>
      </div>
    </div>
  </div>
</Layout>

<!-- Mobile profile drawer -->
<div
  id="profile-drawer"
  class="fixed inset-x-0 bottom-0 z-40 max-h-[80dvh] w-full translate-y-full rounded-t-xl border-t bg-muted transition-transform duration-500"
  tabindex="-1"
  aria-labelledby="profile-drawer"
>
  <div class="flex h-full max-h-[80dvh] flex-col gap-4">
    <div class="grow overflow-y-auto">
      <ul class="space-y-2 p-4 pl-2">
        <li>
          <a
            href="/dashboard"
            class="inline-flex w-full items-center justify-between rounded-lg p-4 text-text/80 duration-300 hover:text-primary"
          >
            <div class="flex items-center gap-4">
              <div class="i-solar-home-smile-linear size-6"></div>
              پیشخوان
            </div>
          </a>
        </li>
        <li>
          <a
            href="/dashboard/orders"
            class="inline-flex w-full items-center justify-between rounded-lg bg-primary/5 p-4 text-primary duration-300"
          >
            <div class="flex items-center gap-4">
              <div class="i-mingcute-shopping-bag-3-line size-6"></div>
              سفارش ها
            </div>
          </a>
        </li>
        <li>
          <a
            href="/dashboard/notifications"
            class="inline-flex w-full items-center justify-between rounded-lg p-4 text-text/80 duration-300 hover:text-primary"
          >
            <div class="flex items-center gap-4">
              <div class="i-lucide-bell size-6"></div>
              پیام ها
            </div>
          </a>
        </li>
        <li>
          <a
            href="/dashboard/favorites"
            class="inline-flex w-full items-center justify-between rounded-lg p-4 text-text/80 duration-300 hover:text-primary"
          >
            <div class="flex items-center gap-4">
              <div class="i-lucide-heart size-6"></div>
              علاقه‌‍مندی ها
            </div>
          </a>
        </li>
        <li>
          <a
            href="/dashboard/recent"
            class="inline-flex w-full items-center justify-between rounded-lg p-4 text-text/80 duration-300 hover:text-primary"
          >
            <div class="flex items-center gap-4">
              <div class="i-lucide-mouse-pointer-click size-6"></div>
              بازدید های اخیر
            </div>
          </a>
        </li>
        <li>
          <a
            href="/dashboard/addresses"
            class="inline-flex w-full items-center justify-between rounded-lg p-4 text-text/80 duration-300 hover:text-primary"
          >
            <div class="flex items-center gap-4">
              <div
                class="i-material-symbols-location-on-outline-rounded size-6"
              >
              </div>
              آدرس ها
            </div>
          </a>
        </li>
        <li>
          <a
            href="/dashboard/profile-edit"
            class="inline-flex w-full items-center justify-between rounded-lg p-4 text-text/80 duration-300 hover:text-primary"
          >
            <div class="flex items-center gap-4">
              <div class="i-lucide-user-cog size-6"></div>
              اطلاعات حساب کاربری
            </div>
          </a>
        </li>
        <li>
          <button
            type="button"
            data-logout-btn
            class="inline-flex w-full items-center justify-between p-4 text-warning"
          >
            <div class="flex items-center gap-4">
              <div class="i-mingcute-exit-line size-6"></div>
              خروج
            </div>
          </button>
        </li>
      </ul>
    </div>
  </div>
</div>

<script>
  import { getCurrentUser, getAccessToken } from "../../lib/auth";
  import {
    getOrders,
    getOrderTotal,
    getOrderItemCount,
    getOrderStatusLabel,
    type Order,
  } from "../../lib/orders";
  import { formatPrice } from "../../lib/cart";

  // Status groupings for the filter tabs.
  const CURRENT_STATUSES = [
    "SUBMITTED",
    "PAYMENT_REQUIRED",
    "PRODUCTION",
    "PRODUCTION_COMPLETE",
    "PROCESSING",
    "SHIPPING",
  ];

  function statusBadgeClass(status: string): string {
    if (status === "COMPLETED") return "bg-success/10 text-success";
    if (status === "CANCELLED") return "bg-warning/10 text-warning";
    if (status === "PAYMENT_REQUIRED") return "bg-primary/10 text-primary";
    return "bg-text/10 text-text/80";
  }

  function formatDate(iso: string): string {
    const date = new Date(iso);
    if (isNaN(date.getTime())) return "";
    return new Intl.DateTimeFormat("fa-IR", {
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(date);
  }

  function orderCard(order: Order): string {
    const total = getOrderTotal(order);
    const count = getOrderItemCount(order);
    const thumbs = order.orderItems
      .slice(0, 4)
      .map((oi) => {
        const src = oi.item.thumbnail?.sm || oi.item.thumbnail?.url || "";
        return src
          ? `<img src="${src}" alt="${oi.item.thumbnail?.altText || oi.item.name}" class="size-14 rounded-lg border object-cover" loading="lazy" />`
          : `<div class="flex size-14 items-center justify-center rounded-lg border text-text/40"><div class="i-lucide-image size-6"></div></div>`;
      })
      .join("");

    return `
      <div class="rounded-lg border p-4">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span class="rounded-full px-3 py-1 text-sm ${statusBadgeClass(order.orderStatus)}">
              ${getOrderStatusLabel(order.orderStatus)}
            </span>
            <span class="text-sm text-text/60">${formatDate(order.createdAt)}</span>
          </div>
          <span class="text-sm text-text/60">شماره سفارش: ${order.id}</span>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-2">${thumbs}</div>
          <div class="flex flex-col items-start gap-1 sm:items-end">
            <span class="text-sm text-text/60">${count} کالا</span>
            <span class="font-medium">${formatPrice(total)} تومان</span>
          </div>
        </div>
      </div>
    `;
  }

  function renderInto(selector: string, orders: Order[]) {
    const container = document.querySelector<HTMLElement>(selector);
    if (!container) return;
    const empty = container.querySelector<HTMLElement>("[data-empty]");
    if (orders.length === 0) {
      if (empty) empty.classList.remove("hidden");
      return;
    }
    if (empty) empty.classList.add("hidden");
    container.insertAdjacentHTML("beforeend", orders.map(orderCard).join(""));
  }

  function setCount(selector: string, value: number) {
    const el = document.querySelector<HTMLElement>(selector);
    if (el) el.textContent = `(${value})`;
  }

  async function init() {
    const token = getAccessToken();
    if (!token) {
      window.location.href = "/auth";
      return;
    }

    const user = await getCurrentUser();
    if (!user) {
      window.location.href = "/auth";
      return;
    }

    const displayName = user.name || user.phoneNumber || user.email || "کاربر";
    document
      .querySelectorAll<HTMLElement>(
        "[data-user-name], [data-user-name-mobile]",
      )
      .forEach((el) => {
        el.textContent = displayName;
      });

    const initial = displayName.charAt(0).toUpperCase();
    document
      .querySelectorAll<HTMLElement>(
        "[data-user-avatar], [data-user-avatar-mobile]",
      )
      .forEach((el) => {
        el.textContent = initial;
      });

    const phoneEl = document.querySelector<HTMLElement>("[data-user-phone]");
    if (phoneEl) phoneEl.textContent = user.phoneNumber || "";

    // Fetch all orders, then bucket them for the sections and tabs. PENDING
    // orders are the cart, so they are excluded from the order history.
    const allOrders = (await getOrders()).filter(
      (o) => o.orderStatus !== "PENDING",
    );

    const pending = allOrders.filter(
      (o) => o.orderStatus === "PAYMENT_REQUIRED",
    );
    const current = allOrders.filter((o) =>
      CURRENT_STATUSES.includes(o.orderStatus),
    );
    const delivered = allOrders.filter((o) => o.orderStatus === "COMPLETED");
    const canceled = allOrders.filter((o) => o.orderStatus === "CANCELLED");

    renderInto("[data-pending-orders]", pending);
    renderInto("[data-orders-all]", allOrders);
    renderInto("[data-orders-current]", current);
    renderInto("[data-orders-delivered]", delivered);
    renderInto("[data-orders-canceled]", canceled);

    setCount("[data-tab-count-all]", allOrders.length);
    setCount("[data-tab-count-current]", current.length);
    setCount("[data-tab-count-delivered]", delivered.length);
    setCount("[data-tab-count-canceled]", canceled.length);
  }

  document.addEventListener("DOMContentLoaded", init);
</script>
