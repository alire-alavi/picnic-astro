<div
  id="address-remove-modal"
  tabindex="-1"
  aria-hidden="true"
  class="fixed left-0 right-0 top-0 z-50 hidden h-[calc(100%-1rem)] max-h-full w-full overflow-y-auto overflow-x-hidden p-4 md:inset-0"
>
  <div class="relative max-h-full w-full max-w-sm">
    <div class="overflow-hidden rounded-lg border bg-muted shadow">
      <!-- Header -->
      <div class="px-4 py-5 sm:px-6">
        <div class="flex items-center justify-between">
          <h3 class="md:text-lg">حذف آدرس</h3>
          <button
            class="text-text/60 duration-300 hover:text-text/95"
            data-modal-hide="address-remove-modal"
            type="button"
          >
            <div class="i-lucide-x size-6"></div>
            <span class="sr-only">Close menu</span>
          </button>
        </div>
      </div>
      <div class="space-y-6 px-4 py-5 sm:p-6">
        <!-- Content -->
        <p>آیا از حذف این آدرس اطمینان دارید؟</p>
        <!-- Footer -->
        <div class="flex justify-end gap-4">
          <button
            data-modal-hide="address-remove-modal"
            type="button"
            class="btn-secondary w-full rounded-lg px-4 py-2 md:w-auto"
          >
            <span>انصراف</span>
          </button>
          <button
            id="address-remove-submit"
            type="button"
            class="btn-warning w-full rounded-lg px-4 py-2 md:w-auto"
          >
            <span>حذف آدرس</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { getCurrentUser, getAccessToken } from "../../lib/auth";
  import {
    getAddresses,
    createAddress,
    updateAddress,
    deleteAddress,
  } from "../../lib/address";
  import { AddressType } from "../../types/address.d";
  import type { Address } from "../../types/address.d";

  let addresses: Address[] = [];
  let currentEditId: string | null = null;
  let currentRemoveId: string | null = null;

  function val(id: string): string {
    return (
      (
        document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement
      )?.value?.trim() ?? ""
    );
  }

  function setVal(id: string, value: string) {
    const el = document.getElementById(id) as
      HTMLInputElement | HTMLTextAreaElement | null;
    if (el) el.value = value;
  }

  function showModal(id: string) {
    const el = document.getElementById(id);
    if (!el) return;
    // @ts-ignore — Flowbite Modal is loaded globally via flowbite.min.js
    const modal = new window.Modal(el);
    modal.show();
  }

  function hideModal(id: string) {
    const el = document.getElementById(id);
    if (!el) return;
    // @ts-ignore
    const modal = window.FlowbiteInstances?.getInstance?.("Modal", id);
    modal?.hide();
  }

  function renderAddresses() {
    const list = document.querySelector<HTMLElement>("[data-addresses]");
    if (!list) return;

    const emptyEl = list.querySelector<HTMLElement>("[data-addresses-empty]");

    // Remove all address items (but keep the empty state node)
    Array.from(list.children).forEach((child) => {
      if (!child.hasAttribute("data-addresses-empty")) child.remove();
    });

    if (addresses.length === 0) {
      if (emptyEl) emptyEl.style.display = "";
      return;
    }

    if (emptyEl) emptyEl.style.display = "none";

    addresses.forEach((addr) => {
      const li = document.createElement("li");
      li.innerHTML = `
        <div class="relative block rounded-lg border p-4 shadow hover:border-border/50">
          <div class="mb-4 flex justify-between gap-x-2 sm:mb-2">
            <div class="line-clamp-1 text-sm text-text/95 xs:text-base">
              <div class="flex gap-1">
                <div class="flex min-w-fit">
                  <p>${addr.state},</p>
                  <p>${addr.city}</p>
                </div>
              </div>
              <div class="flex gap-1">
                <p>${addr.street}</p>
                <p>- کد پستی ${addr.zipCode}</p>
              </div>
            </div>
          </div>
          <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-center">
            <p class="line-clamp-1 text-sm text-text/60">${addr.country}</p>
            <div class="grid w-full grid-cols-2 gap-2 sm:w-fit">
              <div>
                <button
                  type="button"
                  data-remove-address-id="${addr.id}"
                  class="inline-flex h-8 w-full items-center justify-center gap-x-2 whitespace-nowrap rounded-md bg-warning/10 px-3 text-sm font-medium text-warning ring-offset-background transition-colors hover:bg-warning/20 focus-visible:outline-none focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
                >
                  <div class="i-material-symbols-wrong-location-outline-rounded size-5"></div>
                  حذف
                </button>
              </div>
              <div>
                <button
                  type="button"
                  data-edit-address-id="${addr.id}"
                  class="inline-flex h-8 w-full items-center justify-center gap-x-2 whitespace-nowrap rounded-md bg-success/10 px-3 text-sm font-medium text-success ring-offset-background transition-colors hover:bg-success/20 focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50"
                >
                  <div class="i-material-symbols-edit-location-alt-outline-rounded size-5"></div>
                  ویرایش
                </button>
              </div>
            </div>
          </div>
        </div>
      `;
      list.appendChild(li);
    });
  }

  async function loadAddresses() {
    try {
      addresses = await getAddresses();
    } catch {
      addresses = [];
    }
    renderAddresses();
  }

  async function init() {
    const token = getAccessToken();
    if (!token) {
      window.location.href = "/auth";
      return;
    }

    const user = await getCurrentUser();
    if (!user) {
      window.location.href = "/auth";
      return;
    }

    const displayName = user.name || user.phoneNumber || user.email || "کاربر";
    document
      .querySelectorAll<HTMLElement>(
        "[data-user-name], [data-user-name-mobile]",
      )
      .forEach((el) => {
        el.textContent = displayName;
      });

    const initial = displayName.charAt(0).toUpperCase();
    document
      .querySelectorAll<HTMLElement>(
        "[data-user-avatar], [data-user-avatar-mobile]",
      )
      .forEach((el) => {
        el.textContent = initial;
      });

    const phoneEl = document.querySelector<HTMLElement>("[data-user-phone]");
    if (phoneEl) phoneEl.textContent = user.phoneNumber || "";

    await loadAddresses();

    // Event delegation for address list actions
    document
      .querySelector("[data-addresses]")
      ?.addEventListener("click", (e) => {
        const removeBtn = (e.target as Element).closest<HTMLElement>(
          "[data-remove-address-id]",
        );
        const editBtn = (e.target as Element).closest<HTMLElement>(
          "[data-edit-address-id]",
        );

        if (removeBtn) {
          currentRemoveId = removeBtn.getAttribute("data-remove-address-id");
          showModal("address-remove-modal");
        }

        if (editBtn) {
          currentEditId = editBtn.getAttribute("data-edit-address-id");
          const addr = addresses.find((a) => a.id === currentEditId);
          if (addr) {
            setVal("edit-address", addr.street);
            setVal("edit-province", addr.state);
            setVal("edit-city", addr.city);
            setVal("edit-pCode", addr.zipCode);
          }
          showModal("address-edit-modal");
        }
      });

    // Add form submit
    document
      .getElementById("address-add-submit")
      ?.addEventListener("click", async () => {
        const street = val("add-address");
        const state = val("add-province");
        const city = val("add-city");
        const zipCode = val("add-pCode");
        if (!street || !state || !city || !zipCode) return;

        try {
          const newAddr = await createAddress({
            street,
            state,
            city,
            zipCode,
            country: "ایران",
            type: AddressType.SHIPPING,
          });
          addresses.push(newAddr);
          renderAddresses();
          hideModal("address-add-modal");
          // Clear add form
          [
            "add-address",
            "add-province",
            "add-city",
            "add-pCode",
            "add-name",
            "add-family",
            "add-phone",
            "add-nCode",
            "add-bNumber",
            "add-bUnit",
          ].forEach((id) => setVal(id, ""));
        } catch (err) {
          console.error("Failed to create address:", err);
        }
      });

    // Edit form submit
    document
      .getElementById("address-edit-submit")
      ?.addEventListener("click", async () => {
        if (!currentEditId) return;
        const street = val("edit-address");
        const state = val("edit-province");
        const city = val("edit-city");
        const zipCode = val("edit-pCode");
        if (!street || !state || !city || !zipCode) return;

        try {
          const updated = await updateAddress(currentEditId, {
            street,
            state,
            city,
            zipCode,
          });
          addresses = addresses.map((a) =>
            a.id === currentEditId ? updated : a,
          );
          renderAddresses();
          hideModal("address-edit-modal");
          currentEditId = null;
        } catch (err) {
          console.error("Failed to update address:", err);
        }
      });

    // Remove confirm submit
    document
      .getElementById("address-remove-submit")
      ?.addEventListener("click", async () => {
        if (!currentRemoveId) return;
        try {
          await deleteAddress(currentRemoveId);
          addresses = addresses.filter((a) => a.id !== currentRemoveId);
          renderAddresses();
          hideModal("address-remove-modal");
          currentRemoveId = null;
        } catch (err) {
          console.error("Failed to delete address:", err);
        }
      });
  }

  document.addEventListener("DOMContentLoaded", init);
</script>
