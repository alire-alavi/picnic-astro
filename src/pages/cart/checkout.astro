---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import { getCart } from "../../lib/cart";
import { getAddresses } from "../../lib/address";
import type { Product } from "../../types/product.d";
import "../../styles/css/global.css";
import "../../styles/css/dependencies/swiper.min.css";
import "../../styles/css/fonts.css";
import "../../styles/css/app.css";
import "../../styles/css/base.css";
import "../../styles/css/dependencies/nouislider.min.css";
import "../../styles/css/reset.css";

const cart = await getCart();
const addresses = await getAddresses().catch(() => []);
const shippingAddresses = addresses.filter(addr => addr.type === 'SHIPPING');
const defaultAddress = shippingAddresses[0] || null;

const itemCount =
    cart?.orderItems.reduce((sum, item) => sum + item.quantity, 0) || 0;

const subtotal = cart?.orderItems.reduce((sum, item) => 
    sum + (parseFloat(item.price) * item.quantity), 0) || 0;
const discount = 0;
const shippingCost = 60000;
const total = subtotal - discount + shippingCost;

const formatPrice = (price: number) => {
    return new Intl.NumberFormat('fa-IR').format(price);
};
---

<Layout>
    <Navbar />
    <main class="flex-grow bg-background pt-[106px]" data-order-id={cart?.id}>
        <div class="container pb-28 pt-6 lg:pb-10">
            <!--  Breadcrumb -->
            <div class="mb-2 rounded-lg bg-muted shadow lg:mb-6">
                <ol
                    class="relative grid grid-cols-3 overflow-hidden rounded-lg"
                >
                    <li
                        class="z-10 flex flex-col items-center justify-center gap-2 p-4 text-xs text-primary/50 sm:text-sm md:text-base"
                    >
                        <div
                            class="i-lucide-shopping-cart h-6 w-6 md:h-8 md:w-8"
                        >
                        </div>
                        <p class="leading-none">سبد خرید</p>
                    </li>
                    <li
                        class="z-10 flex flex-col items-center justify-center gap-2 p-4 text-xs text-primary sm:text-sm md:text-base"
                    >
                        <div
                            class="i-lucide-clipboard-pen-line h-6 w-6 md:h-8 md:w-8"
                        >
                        </div>

                        <p class="leading-none">شیوه ارسال</p>
                    </li>
                    <li
                        class="z-10 flex flex-col items-center justify-center gap-2 p-4 text-xs text-primary/50 sm:text-sm md:text-base"
                    >
                        <div class="i-lucide-credit-card h-6 w-6 md:h-8 md:w-8">
                        </div>

                        <p class="leading-none">پرداخت</p>
                    </li>
                    <!--  for position set value 0 , 33.33% , 66.66%  -->
                    <div
                        class="absolute bottom-0 z-0 h-full w-1/3 touch-none bg-primary/10 transition-all duration-300"
                        style="inset-inline-start: 33.33%"
                    >
                    </div>
                </ol>
            </div>
            <!-- Content -->
            <div class="grid grid-cols-12 gap-2 lg:gap-6">
                <div class="col-span-12 lg:col-span-8">
                    <div class="rounded-lg bg-muted p-4 shadow">
                        <div>
                            <div
                                class="flex items-center justify-between gap-2 pb-4"
                            >
                                <h1
                                    class="flex items-center gap-x-4 text-sm xs:text-base md:text-lg"
                                >
                                    آدرس تحویل سفارش
                                </h1>
                                <div>
                                    <button
                                        class="inline-flex items-center gap-1 text-sm text-primary duration-200 hover:text-primary/80"
                                        type="button"
                                        data-modal-target="address-add-modal"
                                        data-modal-toggle="address-add-modal"
                                    >
                                        <div
                                            class="i-material-symbols-add-location-alt-outline-rounded size-6"
                                        >
                                        </div>
                                        <span> آدرس جدید </span>
                                    </button>
                                </div>
                            </div>
                            <div class="mb-6" data-address-display>
                                {defaultAddress ? (
                                <div
                                    class="relative block rounded-lg border p-4 shadow hover:border-border/50"
                                >
                                    <div
                                        class="mb-4 flex justify-between gap-x-2 sm:mb-2"
                                    >
                                        <div
                                            class="line-clamp-1 text-sm text-text/95 xs:text-base"
                                        >
                                            <div class="flex gap-1">
                                                <div class="flex min-w-fit">
                                                    <p>{defaultAddress.state},</p>
                                                    <p>{defaultAddress.city}</p>
                                                </div>
                                                <p>{defaultAddress.street}</p>
                                            </div>
                                            <div class="flex gap-1">
                                                <p>کد پستی {defaultAddress.zipCode}</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div
                                        class="flex items-center justify-between gap-x-2"
                                    >
                                        <p
                                            class="line-clamp-1 text-sm text-text/60"
                                        >
                                            {defaultAddress.country}
                                        </p>
                                        <div class="flex justify-end">
                                            <button
                                                type="button"
                                                data-modal-target="address-select-modal"
                                                data-modal-toggle="address-select-modal"
                                                class="inline-flex h-10 cursor-pointer items-center justify-center gap-1 whitespace-nowrap rounded-md bg-primary/10 px-4 py-3 text-sm font-medium text-primary transition-colors hover:bg-primary/20 focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50"
                                            >
                                                <div
                                                    class="i-material-symbols-location-on-outline-rounded size-6"
                                                >
                                                </div>
                                                تغییر
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                ) : (
                                <div class="text-center py-4 text-text/60">
                                    <p>آدرسی ثبت نشده است. لطفا آدرس جدید اضافه کنید.</p>
                                </div>
                                )}
                            </div>
                        </div>
                        <div>
                            <div
                                class="flex items-center justify-between gap-2 pb-4"
                            >
                                <h2
                                    class="flex items-center gap-x-4 text-sm xs:text-base md:text-lg"
                                >
                                    شیوه ارسال
                                </h2>
                            </div>

                            <fieldset
                                class="grid grid-cols-1 gap-2 sm:grid-cols-2"
                            >
                                <legend class="sr-only">Delivery</legend>

                                <div>
                                    <input
                                        type="radio"
                                        name="delivery"
                                        value="delivery-1"
                                        id="delivery-1"
                                        class="peer hidden"
                                        checked={cart?.shippingMethod === 'STANDARD'}
                                    />

                                    <label
                                        for="delivery-1"
                                        class="relative block h-[116px] cursor-pointer rounded-lg border p-4 shadow hover:border-border/50 peer-checked:border-primary"
                                    >
                                        <div
                                            class="mb-4 flex items-center justify-between gap-x-2 sm:mb-2"
                                        >
                                            <p
                                                class="line-clamp-1 text-sm text-text/90 xs:text-base"
                                            >
                                                تیپاکس - ارسال عادی
                                            </p>
                                            <img
                                                src="/src/assets/images/tipax.avif"
                                                alt="tipax"
                                                class="w-25"
                                            />
                                        </div>

                                        <div class="mb-1 text-primary">
                                            <span>{formatPrice(shippingCost)}</span>
                                            <span class="text-sm">تومان</span>
                                        </div>

                                        <div class="text-sm text-primary">
                                            <span> رایگان بالای 500,000 </span>
                                        </div>
                                    </label>
                                </div>

                                <div>
                                    <input
                                        type="radio"
                                        name="delivery"
                                        value="delivery-2"
                                        id="delivery-2"
                                        class="peer hidden"
                                        checked={cart?.shippingMethod === 'EXPRESS'}
                                    />

                                    <label
                                        for="delivery-2"
                                        class="relative block h-[116px] cursor-pointer rounded-lg border p-4 shadow hover:border-border/50 peer-checked:border-primary"
                                    >
                                        <div
                                            class="mb-4 flex items-center justify-between gap-x-2 sm:mb-2"
                                        >
                                            <p
                                                class="line-clamp-1 text-sm text-text/90 xs:text-base"
                                            >
                                                تیپاکس - ارسال سریع
                                            </p>
                                            <img
                                                src="/src/assets/images/tipax.avif"
                                                alt="tipax"
                                                class="w-25"
                                            />
                                        </div>

                                        <div class="text-primary">
                                            <span class="text-sm"
                                                >پرداخت در مقصد</span
                                            >
                                        </div>
                                    </label>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>
                <div class="lg:col-span-4">
                    <div class="hidden rounded-lg bg-muted p-4 shadow lg:block">
                        <div class="mb-2 divide-y">
                            <div
                                class="flex items-center justify-between gap-x-2 py-6"
                            >
                                <div class="text-sm text-text/95 lg:text-base">
                                    قیمت کالا ها ({itemCount})
                                </div>
                                <div
                                    class="flex items-center gap-1 text-sm lg:text-base"
                                >
                                    <div class="font-bold">{formatPrice(subtotal)}</div>
                                    <div class="text-xs lg:text-sm">تومان</div>
                                </div>
                            </div>
                            <div
                                class="flex items-center justify-between gap-x-2 py-6"
                            >
                                <div class="text-sm text-text/95 lg:text-base">
                                    تخفیف کالا ها
                                </div>
                                <div
                                    class="flex items-center gap-1 text-sm font-medium text-warning lg:text-base"
                                >
                                    <div class="font-bold">{formatPrice(discount)}</div>
                                    <div class="text-xs lg:text-sm">تومان</div>
                                </div>
                            </div>
                            <div
                                class="flex items-center justify-between gap-x-2 py-6"
                            >
                                <div class="text-sm text-text/95 lg:text-base">
                                    هزینه ارسال
                                </div>
                                <div
                                    class="flex items-center gap-1 text-sm lg:text-base"
                                >
                                    <div class="font-bold">{formatPrice(shippingCost)}</div>
                                    <div class="text-xs lg:text-sm">تومان</div>
                                </div>
                            </div>

                            <div
                                class="flex items-center justify-between gap-x-2 py-6"
                            >
                                <div class="text-sm text-text/95 lg:text-base">
                                    مبلغ قابل پرداخت
                                </div>
                                <div
                                    class="flex items-center gap-1 text-sm text-primary lg:text-base"
                                >
                                    <div class="font-bold">{formatPrice(total)}</div>
                                    <div class="text-xs lg:text-sm">تومان</div>
                                </div>
                            </div>
                        </div>
                        <div>
                            <a
                                href="/cart/payment"
                                class="inline-flex h-11 w-full items-center justify-center gap-x-2 whitespace-nowrap rounded-md bg-primary-btn px-8 text-sm font-medium text-white ring-offset-background transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
                            >
                                ادامه فرایند خرید
                            </a>
                        </div>
                    </div>
                    <div
                        class="fixed inset-x-0 bottom-0 z-20 rounded-t-xl bg-muted px-4 pb-20 pt-4 transition-all duration-300 lg:hidden"
                        data-onscrollclass="translate-y-1/2"
                    >
                        <div>
                            <a
                                href="/cart/payment"
                                class="inline-flex h-10 w-full items-center justify-center gap-x-2 whitespace-nowrap rounded-md bg-primary-btn px-4 py-2 text-sm font-medium text-white ring-offset-background transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
                            >
                                ادامه | {formatPrice(total)}
                                <span class="text-xs"> تومان </span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Address Selection Modal -->
    <div id="address-select-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50">
        <div class="relative w-full max-w-2xl mx-4 bg-muted rounded-lg shadow-xl p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold">انتخاب آدرس</h3>
                <button type="button" data-modal-close class="text-text/60 hover:text-text">
                    <div class="i-lucide-x size-6"></div>
                </button>
            </div>
            <div data-address-list class="space-y-2 max-h-96 overflow-y-auto">
                {shippingAddresses.map(addr => (
                    <div class="relative block rounded-lg border p-4 shadow hover:border-border/50 cursor-pointer" data-address-select={addr.id}>
                        <div class="mb-2">
                            <div class="text-sm text-text/95">
                                <div class="flex gap-1">
                                    <p>{addr.state}, {addr.city}</p>
                                </div>
                                <p>{addr.street}</p>
                                <p>کد پستی: {addr.zipCode}</p>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>

    <!-- Add Address Modal -->
    <div id="address-add-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50">
        <div class="relative w-full max-w-2xl mx-4 bg-muted rounded-lg shadow-xl p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold">افزودن آدرس جدید</h3>
                <button type="button" data-modal-close class="text-text/60 hover:text-text">
                    <div class="i-lucide-x size-6"></div>
                </button>
            </div>
            <form data-add-address-form class="space-y-4">
                <div>
                    <label for="state" class="block text-sm mb-2">استان</label>
                    <input type="text" id="state" name="state" required class="w-full px-4 py-2 rounded-lg border bg-background" />
                </div>
                <div>
                    <label for="city" class="block text-sm mb-2">شهر</label>
                    <input type="text" id="city" name="city" required class="w-full px-4 py-2 rounded-lg border bg-background" />
                </div>
                <div>
                    <label for="street" class="block text-sm mb-2">آدرس</label>
                    <textarea id="street" name="street" required class="w-full px-4 py-2 rounded-lg border bg-background" rows="3"></textarea>
                </div>
                <div>
                    <label for="zipCode" class="block text-sm mb-2">کد پستی</label>
                    <input type="text" id="zipCode" name="zipCode" required class="w-full px-4 py-2 rounded-lg border bg-background" />
                </div>
                <div class="flex gap-2 justify-end">
                    <button type="button" data-modal-close class="px-4 py-2 rounded-lg border hover:bg-background">
                        انصراف
                    </button>
                    <button type="submit" class="px-4 py-2 rounded-lg bg-primary text-white hover:bg-primary/90">
                        ذخیره
                    </button>
                </div>
            </form>
        </div>
    </div>
</Layout>

<script>
    import '../../scripts/checkout';

    document.addEventListener('DOMContentLoaded', () => {
        const modalTriggers = document.querySelectorAll('[data-modal-target]');
        const modalCloses = document.querySelectorAll('[data-modal-close]');

        modalTriggers.forEach(trigger => {
            trigger.addEventListener('click', () => {
                const modalId = trigger.getAttribute('data-modal-target');
                if (!modalId) return;
                const modal = document.getElementById(modalId);
                if (modal) {
                    modal.classList.remove('hidden');
                    modal.classList.add('flex');
                }
            });
        });

        modalCloses.forEach(close => {
            close.addEventListener('click', () => {
                const modal = close.closest('[id$="-modal"]');
                if (modal) {
                    modal.classList.add('hidden');
                    modal.classList.remove('flex');
                }
            });
        });

        document.querySelectorAll('[id$="-modal"]').forEach(modal => {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    modal.classList.add('hidden');
                    modal.classList.remove('flex');
                }
            });
        });
    });
</script>
