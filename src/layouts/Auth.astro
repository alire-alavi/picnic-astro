---
interface Props {
    title?: string;
}

const { title = "ورود / ثبت نام" } = Astro.props;

import "../styles/css/fonts.css";
import "../styles/css/app.css";
import "../styles/css/base.css";
---

<!doctype html>
<html lang="fa-IR" dir="rtl">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <script is:inline>
            // Apply theme before first paint to avoid a light-mode flash on navigation.
            // Inlined (not an external file) so it runs synchronously with no fetch delay.
            (function () {
                var defaultTheme = "dark";
                var storedTheme = localStorage.getItem("theme");
                if (!storedTheme) {
                    storedTheme = defaultTheme;
                    localStorage.setItem("theme", defaultTheme);
                }
                document.documentElement.classList.toggle(
                    "dark",
                    storedTheme === "dark"
                );
            })();
        </script>
        <script defer src="/src/scripts/theme.js"></script>

        <title>{title}</title>
    </head>
    <body>
        <slot />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
